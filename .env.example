# ==============================================================================
# Smart Traffic Accident Detection & Autonomous Dispatch System
# Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Multimodal VLM Verifier API Keys (Cloud Models)
# ------------------------------------------------------------------------------
# Google Gemini API Key (for gemini-3.7-flash and gemini-3.5-flash verification)
GOOGLE_API_KEY=your_google_gemini_api_key_here
# Alternative alias:
# GEMINI_API_KEY=your_google_gemini_api_key_here

# OpenAI API Key (for gpt-5.4-mini verification)
OPENAI_API_KEY=your_openai_api_key_here

# ------------------------------------------------------------------------------
# 2. Emergency Dispatch Gateway Settings
# ------------------------------------------------------------------------------
# Dispatch Mode: "online" (mNotify SMS & Voice API) or "offline" (GSM / Termux Node)
DISPATCH_MODE=online

# mNotify API Key (Required for online SMS & automated voice dispatch)
API_KEY=your_mnotify_api_key_here

# Offline GSM Gateway (Required only when DISPATCH_MODE=offline)
SMS_GATEWAY_URL=http://192.168.1.100:8080/sms
SMS_GATEWAY_TOKEN=optional_gateway_bearer_token

# ------------------------------------------------------------------------------
# 3. Hardware & Compute Acceleration
# ------------------------------------------------------------------------------
# Set to "1" or "true" to force CPU inference for the RT-DETR object detector
FORCE_CPU=0
